<odoo>
    <!--
    Data induk PT. Kebon Agung (dulu views/ka_base_data.xml di Odoo 10).

    * KB-02: partner Unit/PG, company anak, dan 6 user sekarang di namespace ka_base
      (Odoo 20 menolak membuat record baru atas nama modul base). Di database hasil
      migrasi, xmlid lama base.xxx dipindah ke ka_base.xxx oleh
      migrations/20.0.1.0.0/pre-migrate.py supaya tidak terbentuk record DUPLIKAT.
      Modul lain yang merujuk base.pg_kebonagung dst. harus diganti ke
      ka_base.pg_kebonagung saat di-port. base.main_company & currency tetap milik core.
    * noupdate="1": di database hasil migrasi file ini praktis tidak mengubah apa pun;
      isinya hanya terpakai saat install di database baru (dev/test).
    * Password user TIDAK lagi ditulis di sini (KB-01). User R/K & automated dibuat
      tanpa password; set manual oleh admin bila perlu login.
    * Penyesuaian Odoo 20: image -> image_1920 / logo, groups_id -> group_ids,
      state_id pakai xmlid provinsi (bukan id 621/622), field fax & supplier
      sudah tidak ada di core.
    * Urutan: partner -> company -> user -> isi user R/K di company
      (file Odoo 10 merujuk company sebelum dibuat sehingga gagal di DB kosong).
    -->
    <data noupdate="1">
        <!-- currency update -->
        <record id="base.IDR" model="res.currency">
            <field name="active" eval="True"/>
        </record>
        <record id="base.EUR" model="res.currency">
            <field name="active" eval="False"/>
        </record>
        <record id="base.JPY" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <!-- partner as Operating Unit -->
        <record id="ou_direksi" model="res.partner">
            <field name="name">KANTOR DIREKSI</field>
            <field name="is_company" eval="True"/>
            <field name="street">GRAHA KEBON AGUNG</field>
            <field name="street2">Jl. Raya Margerejo Indah Kav. A 131-132</field>
            <field name="city">Surabaya</field>
            <field name="state_id" ref="base.state_id_ji"/>
            <field name="zip">60238</field>
            <field name="country_id" ref="base.id"/>
            <field name="website">www.ptkebonagung.com</field>
            <field name="phone">031-8497279, 8470317, 8495318, 8498257</field>
            <field name="email">kbadir@ptkebonagung.com</field>
            <field name="image_1920" type="bytes" file="ka_base/static/img/ka.png"/>
            <field name="is_operating_unit" eval="True"/>
        </record>
        <record id="ou_kebonagung" model="res.partner">
            <field name="name">PG. KEBON AGUNG</field>
            <field name="is_company" eval="True"/>
            <field name="street">Jl. Pakisaji</field>
            <field name="city">Malang</field>
            <field name="state_id" ref="base.state_id_ji"/>
            <field name="zip">651052</field>
            <field name="website">www.ptkebonagung.com</field>
            <field name="country_id" ref="base.id"/>
            <field name="phone">0341 – 801064, 801371</field>
            <field name="email">pgkba@ptkebonagung.com</field>
            <field name="is_operating_unit" eval="True"/>
            <field name="image_1920" type="bytes" file="ka_base/static/img/kba.png"/>
        </record>
        <record id="ou_trangkil" model="res.partner">
            <field name="name">PG. TRANGKIL</field>
            <field name="is_company" eval="True"/>
            <field name="street">Desa Trangkil - Kec. Trangkil</field>
            <field name="city">Pati - Jawa Tengah</field>
            <field name="state_id" ref="base.state_id_jt"/>
            <field name="zip">59102</field>
            <field name="website">www.ptkebonagung.com</field>
            <field name="country_id" ref="base.id"/>
            <field name="phone">0295 – 391593, 381005</field>
            <field name="email">pgkba@ptkebonagung.com</field>
            <field name="is_operating_unit" eval="True"/>
            <field name="image_1920" type="bytes" file="ka_base/static/img/tk.png"/>
        </record>

        <!-- companies -->
        <record id="base.main_company" model="res.company">
            <field name="code">0</field>
            <field name="name">PT. KEBON AGUNG</field>
            <field name="street">GRAHA KEBON AGUNG</field>
            <field name="street2">Jl. Raya Margerejo Indah Kav. A 131-132</field>
            <field name="city">Surabaya</field>
            <field name="state_id" ref="base.state_id_ji"/>
            <field name="zip">60238</field>
            <field name="country_id" ref="base.id"/>
            <field name="website">www.ptkebonagung.com</field>
            <field name="phone">031-8497279, 8470317, 8495318, 8498257</field>
            <field name="email">kbadir@ptkebonagung.com</field>
            <field name="currency_id" ref="base.IDR"/>
            <field name="logo" type="bytes" file="ka_base/static/img/ka.png"/>
        </record>
        <record id="kantor_direksi" model="res.company">
            <field name="code">1</field>
            <field name="name">KANTOR DIREKSI</field>
            <field name="partner_id" ref="ou_direksi"/>
            <field name="parent_id" ref="base.main_company"/>
            <field name="currency_id" ref="base.IDR"/>
        </record>
        <record id="pg_kebonagung" model="res.company">
            <field name="code">2</field>
            <field name="name">PG. KEBON AGUNG</field>
            <field name="partner_id" ref="ou_kebonagung"/>
            <field name="parent_id" ref="base.main_company"/>
            <field name="currency_id" ref="base.IDR"/>
        </record>
        <record id="pg_trangkil" model="res.company">
            <field name="code">4</field>
            <field name="name">PG. TRANGKIL</field>
            <field name="partner_id" ref="ou_trangkil"/>
            <field name="parent_id" ref="base.main_company"/>
            <field name="currency_id" ref="base.IDR"/>
        </record>

        <!-- user RK (tanpa password, lihat catatan di atas) -->
        <record id="user_direksi" model="res.users">
            <field name="partner_id" ref="ou_direksi"/>
            <field name="login">1540DIR</field>
            <field name="name">RK Direksi</field>
            <field name="signature">-- R/K Direksi</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('base.group_erp_manager'), ref('base.group_multi_company')])]"/>
            <field name="email">1540DIR@ptkebonagung.com</field>
        </record>
        <record id="user_kebonagung" model="res.users">
            <field name="partner_id" ref="ou_kebonagung"/>
            <field name="login">1540KBA</field>
            <field name="name">RK KebonAgung</field>
            <field name="signature">-- R/K Kebon Agung</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('base.group_erp_manager'), ref('base.group_multi_company')])]"/>
            <field name="email">1540KBA@ptkebonagung.com</field>
        </record>
        <record id="user_trangkil" model="res.users">
            <field name="partner_id" ref="ou_trangkil"/>
            <field name="login">1540TK</field>
            <field name="name">RK Trangkil</field>
            <field name="signature">-- R/K Trangkil</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('base.group_erp_manager'), ref('base.group_multi_company')])]"/>
            <field name="email">1540TK@ptkebonagung.com</field>
        </record>

        <!-- Automated system user -->
        <record id="user_automated_direksi" model="res.users">
            <field name="login">automated_system_direksi</field>
            <field name="name">AUTOMATED SYSTEM DIR</field>
            <field name="signature">-- Automated System DIR</field>
            <field name="company_ids" eval="[(6, 0, [ref('kantor_direksi')])]"/>
            <field name="company_id" ref="kantor_direksi"/>
            <field name="email">no-reply-notification@ptkebonagung.com</field>
        </record>
        <record id="user_automated_kebonagung" model="res.users">
            <field name="login">automated_system_kba</field>
            <field name="name">AUTOMATED SYSTEM KBA</field>
            <field name="signature">-- Automated System KBA</field>
            <field name="company_ids" eval="[(6, 0, [ref('pg_kebonagung')])]"/>
            <field name="company_id" ref="pg_kebonagung"/>
            <field name="email">no-reply-notification@ptkebonagung.com</field>
        </record>
        <record id="user_automated_trangkil" model="res.users">
            <field name="login">automated_system_trangkil</field>
            <field name="name">AUTOMATED SYSTEM TK</field>
            <field name="signature">-- Automated System TK</field>
            <field name="company_ids" eval="[(6, 0, [ref('pg_trangkil')])]"/>
            <field name="company_id" ref="pg_trangkil"/>
            <field name="email">no-reply-notification@ptkebonagung.com</field>
        </record>

        <!-- user R/K & automated per company. Nama di-set ulang di sini karena user R/K
             berbagi partner dengan company-nya: membuat user menimpa nama partner
             (= nama company). Hasil akhir sama dengan produksi Odoo 10. -->
        <record id="kantor_direksi" model="res.company">
            <field name="name">KANTOR DIREKSI</field>
            <field name="intercompany_user_id" ref="user_direksi"/>
            <field name="automated_system_user_id" ref="user_automated_direksi"/>
        </record>
        <record id="pg_kebonagung" model="res.company">
            <field name="name">PG. KEBON AGUNG</field>
            <field name="intercompany_user_id" ref="user_kebonagung"/>
            <field name="automated_system_user_id" ref="user_automated_kebonagung"/>
        </record>
        <record id="pg_trangkil" model="res.company">
            <field name="name">PG. TRANGKIL</field>
            <field name="intercompany_user_id" ref="user_trangkil"/>
            <field name="automated_system_user_id" ref="user_automated_trangkil"/>
        </record>
    </data>
</odoo>
