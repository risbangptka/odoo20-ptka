<odoo>
    <record id="view_pkat_change_request_list" model="ir.ui.view">
        <field name="name">view.pkat.change.request.list</field>
        <field name="model">pkat.change.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="company_id"/>
                <field name="year"/>
                <field name="requester_id"/>
                <field name="has_addition"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_pkat_change_request_form" model="ir.ui.view">
        <field name="name">view.pkat.change.request.form</field>
        <field name="model">pkat.change.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Ajukan" class="btn-primary" invisible="state != 'draft'" groups="ka_pkat.group_pkat_tuk_unit"/>
                    <button name="action_approve_unit" type="object" string="Setujui (Pemimpin Pabrik)" class="btn-primary" invisible="state != 'submitted'" groups="ka_pkat.group_pkat_pemimpin"/>
                    <button name="action_process" type="object" string="Proses (Bagian Anggaran)" class="btn-primary" invisible="state != 'waiting_kd'" groups="ka_pkat.group_pkat_anggaran_kd"/>
                    <button name="action_reject" type="object" string="Tolak" invisible="state not in ('submitted', 'waiting_kd')" groups="ka_pkat.group_pkat_pemimpin,ka_pkat.group_pkat_anggaran_kd"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,waiting_kd,processed"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="company_id"/>
                            <field name="year"/>
                            <field name="requester_id"/>
                            <field name="has_addition"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="letter_number"/>
                            <field name="letter_date"/>
                            <field name="letter_attachment"/>
                            <field name="reject_reason"/>
                        </group>
                    </group>
                    <field name="currency_id" invisible="1"/>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="kind"/>
                            <field name="receiver_line_id"/>
                            <field name="receiver_project_id" optional="hide"/>
                            <field name="giver_line_id"/>
                            <field name="month_from" optional="hide"/>
                            <field name="month_to" optional="hide"/>
                            <field name="amount" sum="Jumlah"/>
                            <field name="reason"/>
                            <field name="benefit_risk" optional="show"/>
                            <field name="sdm_coordinated" optional="hide"/>
                            <field name="approval_tier" optional="hide"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pkat_change_request" model="ir.actions.act_window">
        <field name="name">Pergeseran &amp; Tambahan Anggaran</field>
        <field name="res_model">pkat.change.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
