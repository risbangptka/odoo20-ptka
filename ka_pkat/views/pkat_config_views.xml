<odoo>
    <record id="view_pkat_config_list" model="ir.ui.view">
        <field name="name">view.pkat.config.list</field>
        <field name="model">pkat.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="year"/>
                <field name="pocket_level"/>
                <field name="lock_basis"/>
                <field name="ews_yellow"/>
                <field name="ews_red"/>
                <field name="lock_active"/>
            </list>
        </field>
    </record>
    <record id="view_pkat_config_form" model="ir.ui.view">
        <field name="name">view.pkat.config.form</field>
        <field name="model">pkat.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="year"/>
                            <field name="pocket_level"/>
                            <field name="lock_basis"/>
                        </group>
                        <group>
                            <field name="lock_active"/>
                            <field name="ews_yellow"/>
                            <field name="ews_red"/>
                            <field name="sync_stale_minutes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pkat_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi PKAT</field>
        <field name="res_model">pkat.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_pkat_api_token_list" model="ir.ui.view">
        <field name="name">view.pkat.api.token.list</field>
        <field name="model">pkat.api.token</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="last_used"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_pkat_api_token_form" model="ir.ui.view">
        <field name="name">view.pkat.api.token.form</field>
        <field name="model">pkat.api.token</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Buat Token Baru" class="btn-primary" confirm="Token lama tidak berlaku lagi. Lanjutkan?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="last_used"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pkat_api_token" model="ir.actions.act_window">
        <field name="name">Token API</field>
        <field name="res_model">pkat.api.token</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
