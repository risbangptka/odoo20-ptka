<odoo>
    <record id="view_pkat_check_log_list" model="ir.ui.view">
        <field name="name">view.pkat.check.log.list</field>
        <field name="model">pkat.check.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="user_login"/>
                <field name="check_kind"/>
                <field name="doc_number"/>
                <field name="doc_date"/>
                <field name="account_id"/>
                <field name="project_id"/>
                <field name="pocket_id"/>
                <field name="limit_amount"/>
                <field name="used_amount"/>
                <field name="amount"/>
                <field name="result_code"/>
                <field name="message"/>
            </list>
        </field>
    </record>
    <record id="action_pkat_check_log" model="ir.actions.act_window">
        <field name="name">Log Pemeriksaan</field>
        <field name="res_model">pkat.check.log</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_pkat_lock_log_list" model="ir.ui.view">
        <field name="name">view.pkat.lock.log.list</field>
        <field name="model">pkat.lock.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="company_id"/>
                <field name="pocket_id"/>
                <field name="lock_type"/>
                <field name="locked"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
    <record id="action_pkat_lock_log" model="ir.actions.act_window">
        <field name="name">Log Penguncian</field>
        <field name="res_model">pkat.lock.log</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_pkat_api_log_list" model="ir.ui.view">
        <field name="name">view.pkat.api.log.list</field>
        <field name="model">pkat.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="endpoint"/>
                <field name="idem_key"/>
                <field name="user_login"/>
                <field name="status"/>
                <field name="code"/>
                <field name="duration_ms"/>
                <field name="remote_addr"/>
            </list>
        </field>
    </record>
    <record id="action_pkat_api_log" model="ir.actions.act_window">
        <field name="name">Log API</field>
        <field name="res_model">pkat.api.log</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_pkat_reconcile_list" model="ir.ui.view">
        <field name="name">view.pkat.reconcile.list</field>
        <field name="model">pkat.reconcile</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="year"/>
                <field name="month"/>
                <field name="account_id"/>
                <field name="total_odoo10"/>
                <field name="total_odoo20"/>
                <field name="difference"/>
                <field name="resolved"/>
            </list>
        </field>
    </record>
    <record id="action_pkat_reconcile" model="ir.actions.act_window">
        <field name="name">Rekonsiliasi Realisasi</field>
        <field name="res_model">pkat.reconcile</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
